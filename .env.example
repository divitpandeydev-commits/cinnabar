# Cinnabar Environment Configuration

# Public application base URL (used to generate shortened URLs)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Optional Cloud Database connection (PostgreSQL / Supabase / Neon)
# If omitted, Cinnabar uses the built-in persistent disk-backed database engine.
# DATABASE_URL="postgresql://user:password@localhost:5432/cinnabar?schema=public"

# Environment
NODE_ENV="development"

