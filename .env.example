# ===================================================================
# Cinnabar Production Environment Configuration
# ===================================================================

# 1. Application URL
# The public domain of your deployed application (used for short link generation)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# 2. Persistent Cloud Database (Supabase PostgreSQL)
# Recommended for Vercel, Netlify, and serverless hosting environments.
# If omitted, Cinnabar uses the built-in persistent disk-backed atomic file engine.
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# 3. Security & Administration
# Master secret to authorize administrative deletion of any link
ADMIN_SECRET="generate-a-secure-random-token-here"

# Set to "true" ONLY in local development if you need to shorten http://localhost URLs
ALLOW_LOCAL_URLS="false"

# Node Environment
NODE_ENV="production"
